# ========== LLM 配置（DeepSeek - OpenAI 兼容） ==========
OPENAI_API_KEY=你的DeepSeek_API_Key_填这里
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ========== Embedding 配置（本地 HuggingFace，零网络依赖） ==========
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# 如果改用 OpenAI 兼容的 embedding（如 Ollama / 通义 embedding），改成：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_BASE_URL=...
# EMBEDDING_API_KEY=...

# ========== Chroma 向量数据库配置 ==========
CHROMA_PERSIST_DIR=./data/chroma_db

# ========== LLM 其他参数 ==========
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ========== 应用配置 ==========
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# ========== RAG 配置 ==========
RETRIEVAL_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ========== API 安全（可选） ==========
# API_ACCESS_KEY=your-secret-key
